# Database
POSTGRES_USER=heavy_parking
POSTGRES_PASSWORD=heavy_parking
POSTGRES_DB=heavy_parking
DB_PORT=5432

# Redis
REDIS_PORT=6379

# API
API_PORT=8000
DATABASE_URL=postgresql+psycopg://heavy_parking:heavy_parking@localhost:5432/heavy_parking
REDIS_URL=redis://localhost:6379/0
APP_VERSION=0.1.0
ENVIRONMENT=DEV
DEBUG=true
# Optional in DEV. PROD must set CURSOR_SIGNING_KEY to a shared secret of at least
# 32 bytes on every API worker. Unset DEV keys are ephemeral across restarts.
