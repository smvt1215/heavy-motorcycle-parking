# Database
POSTGRES_USER=heavy_parking
POSTGRES_PASSWORD=heavy_parking
POSTGRES_DB=heavy_parking
DB_PORT=5432

# Redis
REDIS_PORT=6379

# API
API_PORT=8000
DATABASE_URL=postgresql+psycopg://heavy_parking:heavy_parking@localhost:5432/heavy_parking
REDIS_URL=redis://localhost:6379/0
APP_VERSION=0.1.0
ENVIRONMENT=DEV
DEBUG=true
# Optional in DEV. PROD must set CURSOR_SIGNING_KEY to a shared secret of at least
# 32 bytes on every API worker. Unset DEV keys are ephemeral across restarts.

# Destination search (M6). Server-side Google Places API (New) key; never ship it in
# the mobile app. Restrict it to the Places API (New) and the API egress IPs.
GOOGLE_PLACES_API_KEY=

# User features (M8). Access tokens are opaque; only SHA-256 digests are stored.
ACCESS_TOKEN_TTL_DAYS=30
# Report photos go to S3-compatible storage. Leave S3_BUCKET blank to disable uploads
# (503 STORAGE_UNAVAILABLE). Any S3-compatible service works (AWS S3, MinIO, Garage);
# set S3_ENDPOINT_URL for non-AWS services. Never commit real credentials.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=ap-northeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Community verification (#34). Auto-publication stays off until production identity
# verification exists; eligible cases go to manual review instead.
COMMUNITY_AUTO_PUBLISH_ENABLED=false
COMMUNITY_WRITE_RATE_LIMIT_PER_MINUTE=30
